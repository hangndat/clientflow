# Canonical public origin for auth email redirects and callback fallback.
# Must be an allow-listed Redirect URL in Supabase Auth settings.
# Do not derive this from request headers (Origin / Host / X-Forwarded-*).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional comma-separated extra origins for auth callback redirects
# (authorized previews, staging hosts). Example:
# AUTH_ALLOWED_ORIGINS=https://staging.example.com,https://my-app-git-feat.vercel.app
# AUTH_ALLOWED_ORIGINS=

# Public Supabase values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Legacy alias still supported by the app if publishable key is unset
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Never expose in client bundles or commit real values.
# Required for RLS integration tests, admin cleanup, and portal document downloads.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Auth dashboard (manual):
# - Site URL: same value as NEXT_PUBLIC_SITE_URL
# - Redirect URLs allow-list must include:
#   - {NEXT_PUBLIC_SITE_URL}/auth/callback
#   - http://localhost:3000/auth/callback (local)
#   - any AUTH_ALLOWED_ORIGINS / preview origins + /auth/callback
# Vercel previews: platform may set VERCEL_URL; add matching https://$VERCEL_URL/auth/callback
# to the Supabase allow-list or set AUTH_ALLOWED_ORIGINS / NEXT_PUBLIC_SITE_URL per deploy.
