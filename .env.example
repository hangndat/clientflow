# Public app URL used as a fallback for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Legacy alias still supported by the app if publishable key is unset
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Never expose in client bundles or commit real values.
# Required for RLS integration tests and admin cleanup only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
